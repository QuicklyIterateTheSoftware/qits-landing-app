{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.csr.html",
          "/favicon.ico",
          "/apple-touch-icon.png",
          "/*.css",
          "/*.js",
          "/media/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/**/api/**",
    "!/git/**",
    "!/idp/**",
    "!/auth/**",
    "!/events/**",
    "!/landing/**",
    "!/q/**",
    "!/main-navigation",
    "!/main-navigation/**",
    "!/upstream-pools",
    "!/upstream-pools/**"
  ]
}
