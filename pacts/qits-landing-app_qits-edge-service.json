{
  "consumer": {
    "name": "qits-landing-app"
  },
  "interactions": [
    {
      "comments": {
        "references": {
          "qits-call": {
            "app": "qits-edge-service",
            "operationId": "getMainNavigation"
          },
          "qits-trigger": {
            "app": "qits-landing-app",
            "interaction": "load-app-origins",
            "kind": "ui"
          }
        }
      },
      "description": "load-app-origins: getMainNavigation",
      "pending": false,
      "providerStates": [
        {
          "name": "a published navigation",
          "params": {
            "host": "projects.qits.example.com"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/main-navigation"
      },
      "response": {
        "body": {
          "content": {
            "applications": {
              "qits-events": {
                "origin": "https://events.qits.example.com"
              },
              "qits-githost": {
                "origin": "https://githost.qits.example.com"
              },
              "qits-idp": {
                "origin": "https://idp.qits.example.com"
              },
              "qits-maintenance": {
                "origin": "https://maintenance.qits.example.com"
              },
              "qits-projects": {
                "origin": "https://projects.qits.example.com"
              },
              "qits-workspaces": {
                "origin": "https://workspaces.qits.example.com"
              }
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.applications['qits-events'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-githost'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-idp'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-maintenance'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-projects'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-workspaces'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "qits-edge-service"
  }
}