{
  "consumer": {
    "name": "qits-landing-app"
  },
  "interactions": [
    {
      "comments": {
        "references": {
          "qits-call": {
            "app": "qits-edge-service",
            "operationId": "getUpstreamPools"
          },
          "qits-trigger": {
            "app": "qits-landing-app",
            "interaction": "open-version-bumps",
            "kind": "ui"
          }
        }
      },
      "description": "open-version-bumps: getUpstreamPools",
      "pending": false,
      "providerStates": [
        {
          "name": "an open upstream pool",
          "params": {
            "host": "qits.example.com"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/upstream-pools"
      },
      "response": {
        "body": {
          "content": [
            {
              "max": 256,
              "name": "qits-artifacts",
              "open": 1,
              "origin": "dev-qits-artifacts:8080",
              "pool": "ordinary"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "max": 1,
                  "min": 1
                }
              ]
            },
            "$[*].max": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].open": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].pool": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "qits-edge-service"
  }
}