{
  "consumer": {
    "name": "qits-landing-app"
  },
  "interactions": [
    {
      "comments": {
        "references": {
          "qits-call": {
            "app": "qits-edge-service",
            "operationId": "getMainNavigation"
          },
          "qits-trigger": {
            "app": "qits-landing-app",
            "interaction": "find-private-apps",
            "kind": "ui"
          }
        }
      },
      "description": "find-private-apps: getMainNavigation",
      "pending": false,
      "providerStates": [
        {
          "name": "a signed-in caller and a private app",
          "params": {
            "host": "projects.qits.example.com"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/main-navigation"
      },
      "response": {
        "body": {
          "content": {
            "applications": {
              "qits-events": {
                "apiDocs": "/events/q/swagger-ui",
                "origin": "https://events.qits.example.com"
              },
              "qits-githost": {
                "apiDocs": "/githost/q/swagger-ui",
                "origin": "https://githost.qits.example.com"
              },
              "qits-idp": {
                "apiDocs": "/idp/q/swagger-ui",
                "origin": "https://idp.qits.example.com"
              },
              "qits-landing": {
                "origin": "https://qits.example.com"
              },
              "qits-maintenance": {
                "apiDocs": "/maintenance/q/swagger-ui",
                "origin": "https://maintenance.qits.example.com"
              },
              "qits-projects": {
                "apiDocs": "/projects/q/swagger-ui",
                "origin": "https://projects.qits.example.com"
              },
              "qits-stt": {
                "exposure": "private",
                "origin": "https://stt.qits.example.com"
              },
              "qits-workspaces": {
                "apiDocs": "/workspaces/q/swagger-ui",
                "origin": "https://workspaces.qits.example.com"
              }
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.applications['qits-events'].apiDocs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-events'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-githost'].apiDocs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-githost'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-idp'].apiDocs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-idp'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-landing'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-maintenance'].apiDocs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-maintenance'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-projects'].apiDocs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-projects'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-stt'].exposure": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-stt'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-workspaces'].apiDocs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.applications['qits-workspaces'].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "comments": {
        "references": {
          "qits-call": {
            "app": "qits-edge-service",
            "operationId": "getUpstreamPools"
          },
          "qits-trigger": {
            "app": "qits-landing-app",
            "interaction": "open-version-bumps",
            "kind": "ui"
          }
        }
      },
      "description": "open-version-bumps: getUpstreamPools",
      "pending": false,
      "providerStates": [
        {
          "name": "an open upstream pool",
          "params": {
            "host": "qits.example.com"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/upstream-pools"
      },
      "response": {
        "body": {
          "content": [
            {
              "max": 256,
              "name": "qits-artifacts",
              "open": 1,
              "origin": "dev-qits-artifacts:8080",
              "pool": "ordinary"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "max": 1,
                  "min": 1
                }
              ]
            },
            "$[*].max": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].open": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$[*].origin": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].pool": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "qits-edge-service"
  }
}