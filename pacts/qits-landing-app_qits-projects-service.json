      "description": "list-projects: listProjects",
      "pending": false,
      "providerStates": [
        {
          "name": "a project exists",
          "params": {
            "projectId": "00000000-0000-4000-8000-000000000001"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/projects/api/projects"
      },
      "response": {
        "body": {
          "content": {
            "entries": [
              {
                "project": {
                  "id": "00000000-0000-4000-8000-000000000001",
                  "name": "Contract project",
                  "slug": "contract-00000001"
                }
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.entries": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.entries[*].project.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
              ]
            },
            "$.entries[*].project.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.entries[*].project.slug": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
